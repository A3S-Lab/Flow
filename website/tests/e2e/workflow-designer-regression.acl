suite "workflow-designer-regression" {
    version = 1

    scenario "complete-example-canvas-controls" {
        name = "Verify the complete example canvas controls and DSL preview"
        surface = "web"
        timeout_ms = 60000

        viewport "desktop" {
            width = 1440
            height = 900
        }

        navigate "open-complete-example" {
            url = "http://127.0.0.1:4173/Flow/playground?example=cross-border-fulfillment"
        }

        wait "page-ready" {
            text = "跨境高价值订单履约"
        }

        click "fit-complete-canvas" {
            target = css(".react-flow__controls-button:nth-child(3)")
        }

        expect "custom-node-render" {
            visible = css(".flow-playground-node[data-flow-node-type=\"commerce.customs.document-review\"]")
        }

        expect "nested-workflow-canvas-renders" {
            visible = css("[aria-label=\"容器内部画布\"]")
        }

        click "open-header-menu" {
            target = css(".a3s-workflow-header__menu > summary")
        }

        click "open-dsl-preview" {
            target = css(".a3s-workflow-header__menu button")
        }

        expect "dsl-panel" {
            text = "工作流 DSL"
        }

        expect "theme-aware-dsl-editor" {
            visible = css(".flow-playground-document")
        }

        screenshot "dsl-preview" {
            path = "screenshots/workflow-dsl-preview.png"
        }

        click "close-dsl-preview" {
            target = css(".flow-playground-side-panel button[aria-label=\"关闭\"]")
        }

        click "switch-to-polyline" {
            target = css("button[aria-label=\"切换为折线\"]")
        }

        expect "polyline-mode" {
            visible = css("button[aria-label=\"切换为曲线\"]")
        }

        click "switch-back-to-curve" {
            target = css("button[aria-label=\"切换为曲线\"]")
        }

        click "arrange-nodes" {
            target = css("button[aria-label=\"整理节点\"]")
        }

        console "browser-console" {
            path = "evidence/workflow-designer-console.json"
            clear = false
        }

        page_errors "browser-page-errors" {
            path = "evidence/workflow-designer-page-errors.json"
            clear = false
        }
    }

    scenario "edit-connection-label" {
        name = "Edit and restore a presentation-only connection label"
        surface = "web"
        timeout_ms = 60000

        viewport "desktop" {
            width = 1440
            height = 900
        }

        navigate "open-complete-example" {
            url = "http://127.0.0.1:4173/Flow/playground?example=cross-border-fulfillment"
        }

        wait "page-ready" {
            text = "跨境高价值订单履约"
        }

        click "select-done-connection" {
            target = css("[data-edge-id=\"edge_validate_order_success_route_serviceability_in\"] .a3s-workflow-edge-label__text")
        }

        click "open-edge-label-editor" {
            target = css("[data-edge-id=\"edge_validate_order_success_route_serviceability_in\"] .a3s-workflow-edge-label__edit")
        }

        expect "edge-label-editor" {
            visible = css("[data-edge-id=\"edge_validate_order_success_route_serviceability_in\"] input[aria-label=\"编辑连线名称\"]")
        }

        fill "connection-label" {
            target = css("[data-edge-id=\"edge_validate_order_success_route_serviceability_in\"] input[aria-label=\"编辑连线名称\"]")
            value = "物流已全部完成"
        }

        press "save-connection-label" {
            key = "Enter"
        }

        expect "custom-connection-label" {
            text = "物流已全部完成"
        }

        expect "stable-source-handle" {
            visible = css("[data-edge-id=\"edge_validate_order_success_route_serviceability_in\"]")
        }

        console "edge-label-console" {
            path = "evidence/workflow-edge-label-console.json"
            clear = false
        }

        page_errors "edge-label-page-errors" {
            path = "evidence/workflow-edge-label-page-errors.json"
            clear = false
        }
    }

    scenario "nested-edge-rendering" {
        name = "Keep child-scope edge overlays visible across viewport changes"
        surface = "web"
        timeout_ms = 60000

        viewport "desktop" {
            width = 1440
            height = 900
        }

        navigate "open-complete-example" {
            url = "http://127.0.0.1:4173/Flow/playground?example=cross-border-fulfillment"
        }

        wait "page-ready" {
            text = "跨境高价值订单履约"
        }

        click "fit-complete-canvas" {
            target = css(".react-flow__controls-button[aria-label=\"Fit View\"]")
        }

        expect "nested-edge-after-fit" {
            visible = css(".a3s-workflow-internal-edge-overlay[data-edge-id=\"edge_item_iteration_start_next_normalize_line_in\"] path")
        }

        click "open-iteration-inspector" {
            target = css(".react-flow__node[data-id=\"item_iteration\"] article")
        }

        expect "iteration-inspector" {
            text = "逐项分配库存"
        }

        click "fit-with-inspector" {
            target = css(".react-flow__controls-button[aria-label=\"Fit View\"]")
        }

        expect "nested-edge-with-inspector" {
            visible = css(".a3s-workflow-internal-edge-overlay[data-edge-id=\"edge_item_iteration_start_next_normalize_line_in\"]")
        }

        click "zoom-in-with-inspector" {
            target = css(".react-flow__controls-button[aria-label=\"Zoom In\"]")
        }

        expect "nested-edge-after-zoom" {
            visible = css(".a3s-workflow-internal-edge-overlay[data-edge-id=\"edge_item_iteration_start_next_normalize_line_in\"]")
        }

        screenshot "nested-edge-rendering" {
            path = "screenshots/nested-edge-rendering.png"
        }

        console "nested-edge-console" {
            path = "evidence/nested-edge-console.json"
            clear = false
        }

        page_errors "nested-edge-page-errors" {
            path = "evidence/nested-edge-page-errors.json"
            clear = false
        }
    }
}
